# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Bb]uild/
/[Bb]uilds/
/.utmp/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/ProfilerCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDE / tooling
.vs/
.vscode/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Build artifacts
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# Burst debug info
/[Ll]ibrary/BurstCache/
*_BurstDebugInformation_DoNotShip/

# Auto-generated Gradle
/[Aa]ssets/Plugins/Android/*.gradle.bak

# OS
.DS_Store
Thumbs.db

# Local benchmark output
/BenchmarkResults/

# Generated by com.unity.test-framework.performance on test runs
/Assets/Resources/PerformanceTestRun*.json
/Assets/Resources/PerformanceTestRun*.json.meta

# Mixamo sources: not redistributed (licence) and too large; re-download with Tools/Mixamo/mixamo_fetch.py.
# Baked outputs under Assets/Art/Crowd are committed.
/Assets/ThirdParty/Mixamo/Characters/*
/Assets/ThirdParty/Mixamo/Animations/*
!/Assets/ThirdParty/Mixamo/Characters/README.md
!/Assets/ThirdParty/Mixamo/Characters/README.md.meta
!/Assets/ThirdParty/Mixamo/Animations/README.md
!/Assets/ThirdParty/Mixamo/Animations/README.md.meta
